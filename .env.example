# Public URL and same-origin session settings. Terminate HTTPS at the host or
# an external reverse proxy before forwarding to the Compose gateway.
WT_SYNC_PUBLIC_BASE_URL=https://sync.example.org
WT_SYNC_ENVIRONMENT=production
WT_SYNC_API_PREFIX=/api/v1
# JSON list of additional credentialed browser origins. Same-origin needs no
# CORS entry; production accepts only explicit HTTPS origins.
WT_SYNC_CORS_ORIGINS=[]
WT_SYNC_ADMIN_MFA_MAX_AGE_SECONDS=43200
WT_SYNC_VERIFICATION_RESEND_COOLDOWN_SECONDS=300
WT_SYNC_INVITE_RESEND_COOLDOWN_SECONDS=300
WT_SYNC_MAX_CONNECTIONS_PER_WORKSPACE=20
WT_SYNC_MAX_PUSH_SUBSCRIPTIONS_PER_USER_WORKSPACE=10
WT_SYNC_PASSWORD_HASH_MAX_CONCURRENCY=2
WT_SYNC_PASSWORD_HASH_ACQUIRE_TIMEOUT_SECONDS=0.25
WT_SYNC_ENCRYPTION_KEY_VERSION=1
# Direct secret values consumed by compose.yaml. Replace every placeholder;
# .env is ignored by Git and must remain readable only by the deploy user.
WT_SYNC_APPLICATION_SECRET=replace-with-random-application-secret-at-least-32-characters
WT_SYNC_ENCRYPTION_SECRET=replace-with-different-random-encryption-secret-at-least-32-characters
# JSON keyring, normally {}; populate only while rotating encryption keys.
WT_SYNC_ENCRYPTION_PREVIOUS_SECRETS={}
WT_SYNC_REDIS_URL=redis://redis:6379/0

# PostgreSQL schema owner plus separate least-privilege API, worker/scheduler,
# and platform-admin roles. Every password must be unique. Role names are fixed
# by the init hook and revision 0008.
POSTGRES_DB=worshipsync
POSTGRES_USER=worshipsync_owner
POSTGRES_OWNER_PASSWORD=replace-owner-password
POSTGRES_API_PASSWORD=replace-api-password
POSTGRES_WORKER_PASSWORD=replace-worker-password
POSTGRES_ADMIN_PASSWORD=replace-admin-password
WT_SYNC_DATABASE_OWNER_URL=postgresql+psycopg://worshipsync_owner:replace-owner-password@postgres:5432/worshipsync
WT_SYNC_DATABASE_API_URL=postgresql+psycopg://worshipsync_api:replace-api-password@postgres:5432/worshipsync
WT_SYNC_DATABASE_WORKER_URL=postgresql+psycopg://worshipsync_worker:replace-worker-password@postgres:5432/worshipsync
WT_SYNC_DATABASE_ADMIN_URL=postgresql+psycopg://worshipsync_admin:replace-admin-password@postgres:5432/worshipsync

# Bootstrap; remove after the first platform administrator exists
WT_SYNC_BOOTSTRAP_ADMIN_EMAIL=admin@example.org
WT_SYNC_BOOTSTRAP_ADMIN_PASSWORD=replace-bootstrap-admin-password

# SMTP is used for verification, recovery and notifications
WT_SYNC_SMTP_HOST=smtp.example.org
WT_SYNC_SMTP_PORT=587
WT_SYNC_SMTP_USERNAME=mailer@example.org
WT_SYNC_SMTP_PASSWORD=
WT_SYNC_SMTP_FROM=Sync Plattform <mailer@example.org>
WT_SYNC_SMTP_STARTTLS=true

# Web Push
WT_SYNC_VAPID_PUBLIC_KEY=
WT_SYNC_VAPID_PRIVATE_KEY=
WT_SYNC_VAPID_SUBJECT=mailto:admin@example.org

# Optional/deprecated Telegram provider, disabled by default
WT_SYNC_TELEGRAM_ENABLED=false
WT_SYNC_TELEGRAM_BOT_TOKEN=
WT_SYNC_TELEGRAM_CHAT_ID=
# Telegram is restricted to one workspace to prevent cross-tenant leaks.
WT_SYNC_TELEGRAM_WORKSPACE_ID=

# Plain-HTTP hop from a host-local TLS reverse proxy to the unprivileged
# gateway. Keep the loopback binding unless a protected remote load balancer
# must reach it.
GATEWAY_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080

# Every secret above also supports a file-backed form when containers are run
# directly or with a custom Compose override. Never set a direct value and its
# _FILE counterpart together. The standard compose.yaml uses direct values and
# does not mount these paths. Supported container variables:
# POSTGRES_PASSWORD_FILE=/run/secrets/postgres_owner_password
# POSTGRES_API_PASSWORD_FILE=/run/secrets/postgres_api_password
# POSTGRES_WORKER_PASSWORD_FILE=/run/secrets/postgres_worker_password
# POSTGRES_ADMIN_PASSWORD_FILE=/run/secrets/postgres_admin_password
# WT_SYNC_DATABASE_URL_FILE=/run/secrets/database_url
# WT_SYNC_DATABASE_OWNER_URL_FILE=/run/secrets/database_owner_url
# WT_SYNC_DATABASE_ADMIN_URL_FILE=/run/secrets/database_admin_url
# WT_SYNC_REDIS_URL_FILE=/run/secrets/redis_url
# WT_SYNC_APPLICATION_SECRET_FILE=/run/secrets/application_secret
# WT_SYNC_ENCRYPTION_SECRET_FILE=/run/secrets/encryption_secret
# WT_SYNC_ENCRYPTION_PREVIOUS_SECRETS_FILE=/run/secrets/encryption_previous_secrets
# WT_SYNC_SMTP_PASSWORD_FILE=/run/secrets/smtp_password
# WT_SYNC_VAPID_PRIVATE_KEY_FILE=/run/secrets/vapid_private_key
# WT_SYNC_TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_bot_token
# WT_SYNC_BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/bootstrap_admin_password
